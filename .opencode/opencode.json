{
    "$schema": "https://opencode.ai/config.json",
    "model": "qwen3.6:35b-128k",
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 10000,
        "model": "qwen3.6:35b-128k"
    },
    "provider": {
        "ollama": {
            "models": {
                "qwen3.6:35b-128k": {
                    "name": "Qwen 3.6 35B 128K",
                    "limit": {
                        "context": 65536,
                        "output": 10240
                    }
                },
                "qwen3-coder:30b-128k": {
                    "name": "Qwen3 Coder 30B 128K",
                    "limit": {
                        "context": 65536,
                        "output": 10240
                    }
                }
            }
        }
    },
    "agent": {
        "build": {
            "mode": "primary",
            "model": "ollama/qwen3.6:35b-128k",
            "temperature": 0.1,
            "prompt": "You are the Local Project build/debug agent. Focus on diagnosis, small patches, tests, commits, and pushes. Prefer correctness over speed."
        },
        "coder": {
            "mode": "primary",
            "model": "ollama/qwen3-coder:30b-128k",
            "temperature": 0.1,
            "prompt": "You are the Local Project coding agent. Implement clearly scoped changes using existing project patterns. Do not redesign architecture unless requested."
        }
    },
    "instructions": [
        "AGENTS.md",
        "NEXT.md",
        "ROADMAP.md",
        "DESIGN.md",
        "README.md"
    ],
    "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
            "*": "ask",
            "pwd*": "allow",
            "ls*": "allow",
            "tree*": "allow",
            "find*": "allow",
            "grep*": "allow",
            "egrep*": "allow",
            "fgrep*": "allow",
            "cat*": "allow",
            "head*": "allow",
            "tail*": "allow",
            "less*": "allow",
            "more*": "allow",
            "wc*": "allow",
            "sed*": "allow",
            "awk*": "allow",
            "sort*": "allow",
            "uniq*": "allow",
            "cut*": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git show*": "allow",
            "git branch*": "allow",
            "git add*": "allow",
            "git commit*": "allow",
            "git push*": "allow",
            "composer install*": "allow",
            "composer test*": "allow",
            "vendor/bin/phpunit*": "allow",
            "php -l*": "allow",
            "php cli*": "allow"
        }
    }
}
